      "id": "hilfe-t10",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 1400
      },
      "data": {
        "title": "Tipp",
        "markdown": "Erst ausmultiplizieren: $x^2 + 3x + 2$. Dann $x^2$ abziehen."

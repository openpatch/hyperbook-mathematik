      }
    },
    {
      "id": "hilfe-t7",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 980
      },
      "data": {
        "title": "Tipp",
        "markdown": "$2x \\cdot x = 2x^2$, $2x \\cdot 4 = 8x$, $(-3) \\cdot x = -3x$, $(-3) \\cdot 4 = -12$."
      }
    },
    {
      "id": "t8",
      "type": "task-numeric",
      "data": {
        "instruction": "Wie viele Produkte entstehen bei $(a + b + c)(x + y)$, bevor man zusammenfasst?",
        "expected": "6",
        "tolerance": "exact",
        "decimalSeparator": "both",
        "allowExpression": false,
        "valueFeedback": [
          {
            "value": "5",
            "feedback": {
              "message": "Nicht addieren: Jedes der 3 Glieder wird mit jedem der 2 Glieder multipliziert.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 1120
      }
    },
    {
      "id": "hilfe-t8",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 1120
      },
      "data": {
        "title": "Tipp",
        "markdown": "Drei Glieder mal zwei Glieder: $3 \\cdot 2$."
      }
    },
    {
      "id": "t9",
      "type": "task-yes-no",
      "data": {
        "question": "Stimmt das? $(x + 4)(x - 1) = x^2 + 3x - 4$",
        "correctAnswer": true,
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {

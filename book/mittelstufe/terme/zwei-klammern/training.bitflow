  "nodes": [
    {
      "id": "start",
      "type": "start-simple",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "title": "Training: Zwei Klammern multiplizieren",
        "markdown": "Zehn Aufgaben zum Multiplizieren von zwei Klammern. Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch.",
        "showOutline": false
      }
    },
    {
      "id": "t1",
      "type": "task-math",
      "data": {
        "instruction": "Multipliziere aus.",
        "latex": "(a+b)(c+d)=\\placeholder[t]{}",
        "blanks": {
          "t": {
            "expected": "ac+ad+bc+bd",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "t",
            "latex": "ac+bd",
            "feedback": {
              "message": "Es fehlen zwei Produkte. Jedes Glied wird mit jedem multipliziert.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 140
      }
    },
    {
      "id": "hilfe-t1",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 140
      },
      "data": {
        "title": "Tipp",
        "markdown": "Vier Bögen: $a \\cdot c$, $a \\cdot d$, $b \\cdot c$, $b \\cdot d$."
      }
    },
    {
      "id": "t2",
      "type": "task-math",
      "data": {
        "instruction": "Multipliziere aus und fasse zusammen.",
        "latex": "(x+3)(x+5)=x^2+\\placeholder[a]{}x+\\placeholder[b]{}",
        "blanks": {
          "a": {
            "expected": "8",
            "accepted": []
          },
          "b": {
            "expected": "15",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "b",
            "latex": "8",
            "feedback": {
              "message": "3 · 5 = 15. Die Zahlen werden multipliziert.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 280
      }
    },
    {
      "id": "hilfe-t2",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 280
      },
      "data": {
        "title": "Tipp",
        "markdown": "$x \\cdot x = x^2$, $x \\cdot 5 = 5x$, $3 \\cdot x = 3x$, $3 \\cdot 5 = 15$. Dann $5x + 3x = 8x$."
      }
    },
    {
      "id": "t3",
      "type": "task-math",
      "data": {
        "instruction": "Multipliziere aus und fasse zusammen.",
        "latex": "(x-2)(x+9)=x^2+\\placeholder[a]{}x+\\placeholder[b]{}",
        "blanks": {
          "a": {
            "expected": "7",
            "accepted": []
          },
          "b": {
            "expected": "-18",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "a",
            "latex": "11",
            "feedback": {
              "message": "−2 · x = −2x. Also 9x − 2x = 7x.",
              "severity": "warning"
            }
          },
          {
            "blank": "b",
            "latex": "18",
            "feedback": {
              "message": "(−2) · 9 = −18.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 420
      }
    },
    {
      "id": "hilfe-t3",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 420
      },
      "data": {
        "title": "Tipp",
        "markdown": "Malkreuz: $x \\cdot x = x^2$, $x \\cdot 9 = 9x$, $(-2) \\cdot x = -2x$, $(-2) \\cdot 9 = -18$."
      }
    },
    {
      "id": "t4",
      "type": "task-math",
      "data": {
        "instruction": "Multipliziere aus und fasse zusammen.",
        "latex": "(x-4)(x-5)=x^2+\\placeholder[a]{}x+\\placeholder[b]{}",
        "blanks": {
          "a": {
            "expected": "-9",
            "accepted": []
          },
          "b": {
            "expected": "20",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "b",
            "latex": "-20",
            "feedback": {
              "message": "(−4) · (−5) = +20.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 560
      }
    },
    {
      "id": "hilfe-t4",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 560
      },
      "data": {
        "title": "Tipp",
        "markdown": "$(-4) \\cdot (-5) = +20$ und $-5x - 4x = -9x$."
      }
    },
    {
      "id": "t5",
      "type": "task-numeric",
      "data": {
        "instruction": "Ein Grundstück ist $30$ m breit und $20$ m tief. Es wird um $4$ m breiter und $5$ m tiefer. Um wie viele m² wächst es?",
        "expected": "250",
        "tolerance": "exact",
        "decimalSeparator": "both",
        "allowExpression": false,
        "valueFeedback": [
          {
            "value": "230",
            "feedback": {
              "message": "Die Ecke 4 · 5 = 20 m² fehlt.",
              "severity": "warning"
            }
          },
          {
            "value": "850",
            "feedback": {
              "message": "Gefragt ist der Zuwachs, nicht die neue Fläche.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 700
      }
    },
    {
      "id": "hilfe-t5",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 700
      },
      "data": {
        "title": "Tipp",
        "markdown": "Neue Fläche $34 \\cdot 25 = 850$ m², alte Fläche $600$ m². Oder in Teilen: $30 \\cdot 5 + 4 \\cdot 20 + 4 \\cdot 5$."
      }
    },
    {
      "id": "t6",
      "type": "task-choice",
      "data": {
        "instruction": "Welcher Term ist $(x - 2) - (x + 9)$?",
        "variant": "single",
        "choices": [
          {
            "id": "o1",
            "markdown": "$-11$",
            "correct": true
          },
          {
            "id": "o2",
            "markdown": "$x^2 + 7x - 18$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Zwischen den Klammern steht minus, nicht mal.",
              "severity": "warning"
            }
          },
          {
            "id": "o3",
            "markdown": "$2x + 7$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Das wäre die Summe der Klammern.",
              "severity": "warning"
            }
          },
          {
            "id": "o4",
            "markdown": "$-7$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Das Minus vor der zweiten Klammer gilt auch für die 9.",
              "severity": "warning"
            }
          }
        ],
        "shuffle": true,
        "partialCredit": false,
        "patternFeedback": [],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 840
      }
    },
    {
      "id": "hilfe-t6",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 840
      },
      "data": {
        "title": "Tipp",
        "markdown": "Zwischen den Klammern steht ein Minus. Löse die Minusklammer auf: $x - 2 - x - 9$."
      }
    },
    {
      "id": "t7",
      "type": "task-math",
      "data": {
        "instruction": "Multipliziere aus und fasse zusammen.",
        "latex": "(2x-3)(x+4)=\\placeholder[a]{}x^2+\\placeholder[b]{}x+\\placeholder[c]{}",
        "blanks": {
          "a": {
            "expected": "2",
            "accepted": []
          },
          "b": {
            "expected": "5",
            "accepted": []
          },
          "c": {
            "expected": "-12",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "b",
            "latex": "11",
            "feedback": {
              "message": "(−3) · x = −3x. Also 8x − 3x = 5x.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,

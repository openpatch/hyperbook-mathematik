    {
      "id": "hilfe-t9",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 1260
      },
      "data": {
        "title": "Tipp",
        "markdown": "$x^2 - x + 4x - 4 = x^2 + 3x - 4$."
      }
    },

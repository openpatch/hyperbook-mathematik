      "id": "start",
      "type": "start-simple",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "title": "Teste dich: Ausmultiplizieren",
        "markdown": "Acht Aufgaben zu den drei binomischen Formeln. Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch.",
        "showOutline": false
      }
    },
    {
      "id": "f-zuordnen",
      "type": "task-matching",
      "data": {
        "instruction": "Ordne jeder Formel die richtige Summe zu.",
        "pairs": [
          {
            "id": "p1",
            "left": {
              "kind": "text",
              "label": "(a + b)²"
            },
            "right": {
              "kind": "text",
              "label": "a² + 2ab + b²"
            }
          },
          {
            "id": "p2",
            "left": {
              "kind": "text",
              "label": "(a − b)²"
            },
            "right": {
              "kind": "text",
              "label": "a² − 2ab + b²"
            }
          },
          {
            "id": "p3",
            "left": {
              "kind": "text",
              "label": "(a + b) · (a − b)"
            },
            "right": {
              "kind": "text",
              "label": "a² − b²"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 140
      }
    },
    {
      "id": "hilfe-f-zuordnen",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 140
      },
      "data": {
        "title": "Die binomischen Formeln",
        "markdown": "1. $(a+b)^2 = a^2 + 2ab + b^2$\n2. $(a-b)^2 = a^2 - 2ab + b^2$\n3. $(a+b)(a-b) = a^2 - b^2$"
      }
    },
    {
      "id": "f1",
      "type": "task-math",
      "data": {
        "instruction": "Multipliziere aus. Fülle die Lücken.",
        "latex": "(x+3)^2=x^2+\\placeholder[b]{}x+\\placeholder[c]{}",
        "blanks": {
          "b": {
            "expected": "6",
            "accepted": []
          },
          "c": {
            "expected": "9",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "b",
            "latex": "3",
            "feedback": {
              "message": "Das Mittelglied ist 2 · a · b = 2 · x · 3.",
              "severity": "warning"
            }
          },
          {
            "blank": "c",
            "latex": "6",
            "feedback": {
              "message": "3² = 3 · 3 = 9, nicht 2 · 3.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false

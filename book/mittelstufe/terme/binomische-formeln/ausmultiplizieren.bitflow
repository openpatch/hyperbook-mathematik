    {
      "id": "hilfe-f8",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 1260
      },
      "data": {
        "title": "Auch mit Brüchen",
        "markdown": "$\\left(\\frac{1}{2}x\\right)^2 = \\frac{1}{4}x^2$\n\n$2 \\cdot \\frac{1}{2}x \\cdot 4 = 4x$\n\n$4^2 = 16$"
      }
    },

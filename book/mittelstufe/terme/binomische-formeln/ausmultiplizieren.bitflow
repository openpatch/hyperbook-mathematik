    {
      "id": "hilfe-f7",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 1120
      },
      "data": {
        "title": "Das Mittelglied fehlt",
        "markdown": "Denk an das Quadrat aus vier Teilen: Es fehlen die zwei Rechtecke $2 \\cdot x \\cdot 4 = 8x$.\n\nRichtig ist $(x+4)^2 = x^2 + 8x + 16$."
      }
    },
    {
      "id": "f8",
      "type": "task-math",

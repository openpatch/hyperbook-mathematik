      "position": {
        "x": 360,
        "y": 560
      },
      "data": {
        "title": "Dritte binomische Formel",
        "markdown": "$(a+b)(a-b) = a^2 - b^2$. Die gemischten Glieder $+6a$ und $-6a$ heben sich auf. Übrig bleibt $a^2 - 6^2$."
      }
    },

      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 420
      },
      "data": {
        "title": "Quadrate suchen",
        "markdown": "$49 = 7^2$ und $2 \\cdot x \\cdot 7 = 14x$ ✓"
      }
    },

    {
      "id": "hilfe-t1",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 140
      },
      "data": {
        "title": "Die binomischen Formeln",
        "markdown": "1. $(a+b)^2 = a^2 + 2ab + b^2$\n2. $(a-b)^2 = a^2 - 2ab + b^2$\n3. $(a+b)(a-b) = a^2 - b^2$"
      }
    },
    {
      "id": "t2",
      "type": "task-math",
      "data": {
        "instruction": "Multipliziere aus.",
        "latex": "(2a-5)^2=\\placeholder[p]{}a^2-\\placeholder[q]{}a+\\placeholder[r]{}",
        "blanks": {
          "p": {
            "expected": "4",
            "accepted": []
          },
          "q": {
            "expected": "20",
            "accepted": []
          },
          "r": {
            "expected": "25",
            "accepted": []

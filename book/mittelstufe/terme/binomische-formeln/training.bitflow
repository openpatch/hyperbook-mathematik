      "data": {
        "title": "Gemischtes Training",
        "markdown": "Acht gemischte Aufgaben zu allen Themen. Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch.",
        "showOutline": false
      }
    },
    {

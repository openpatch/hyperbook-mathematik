    {
      "id": "hilfe-k1",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 140
      },
      "data": {
        "title": "Quadrate suchen",
        "markdown": "$16 = 4^2$. Prüfe das Mittelglied: $2 \\cdot x \\cdot 4 = 8x$ ✓"
      }
    },
    {
      "id": "k2",
      "type": "task-math",
      "data": {

    {
      "id": "hilfe-k2",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 280
      },
      "data": {
        "title": "Quadrate suchen",
        "markdown": "$36 = 6^2$. Prüfe das Mittelglied: $2 \\cdot x \\cdot 6 = 12x$ ✓. Wegen $-12x$ ist es die zweite Formel."
      }
    },
    {
      "id": "k3",
      "type": "task-math",
      "data": {
        "instruction": "Faktorisiere.",
        "latex": "x^2-81=(x+\\placeholder[a]{})(x-\\placeholder[b]{})",
        "blanks": {
          "a": {
            "expected": "9",
            "accepted": []
          },
          "b": {
            "expected": "9",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [],
        "evaluation": {
          "mode": "auto",

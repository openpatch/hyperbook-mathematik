      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "title": "Teste dich: Faktorisieren",
        "markdown": "Schreibe die Summen als Produkt. Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch.",
        "showOutline": false
      }
    },
    {
      "id": "k1",
      "type": "task-math",
      "data": {
        "instruction": "Faktorisiere.",
        "latex": "x^2+8x+16=(x+\\placeholder[a]{})^2",
        "blanks": {
          "a": {
            "expected": "4",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "a",
            "latex": "16",
            "feedback": {
              "message": "Gesucht ist die Zahl, deren Quadrat 16 ist.",
              "severity": "warning"
            }
          },
          {
            "blank": "a",
            "latex": "8",
            "feedback": {
              "message": "Gesucht ist die Zahl, deren Quadrat 16 ist.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false

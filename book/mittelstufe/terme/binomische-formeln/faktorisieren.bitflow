      }
    },
    {
      "id": "hilfe-k3",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 420
      },
      "data": {
        "title": "Differenz von zwei Quadraten",
        "markdown": "$x^2 - 81 = x^2 - 9^2$. Das passt zur dritten Formel $a^2 - b^2 = (a+b)(a-b)$."
      }
    },
    {
      "id": "k4",
      "type": "task-math",
      "data": {
        "instruction": "Faktorisiere.",
        "latex": "4x^2+20x+25=(\\placeholder[a]{}x+\\placeholder[b]{})^2",
        "blanks": {
          "a": {
            "expected": "2",
            "accepted": []
          },
          "b": {
            "expected": "5",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "a",
            "latex": "4",
            "feedback": {
              "message": "Gesucht ist, was quadriert 4x² ergibt: (2x)² = 4x².",
              "severity": "warning"
            }
          },
          {
            "blank": "b",
            "latex": "25",
            "feedback": {
              "message": "Gesucht ist die Zahl, deren Quadrat 25 ist.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 560
      }
    },
    {
      "id": "hilfe-k4",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 560
      },
      "data": {
        "title": "Quadrate suchen",
        "markdown": "$4x^2 = (2x)^2$ und $25 = 5^2$. Prüfe: $2 \\cdot 2x \\cdot 5 = 20x$ ✓"
      }
    },
    {
      "id": "k5",
      "type": "task-math",
      "data": {
        "instruction": "Faktorisiere.",
        "latex": "49-y^2=(\\placeholder[a]{}+y)(\\placeholder[b]{}-y)",

    {
      "id": "hilfe-t6",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 840
      },
      "data": {
        "title": "Tipp",
        "markdown": "$5x - (2x - 4) = 5x - 2x + 4$."
      }
    },
    {
      "id": "t7",
      "type": "task-math",
      "data": {
        "instruction": "Vereinfache.",
        "latex": "7x-4(2x-5y)=\\placeholder[a]{}x+\\placeholder[b]{}y",

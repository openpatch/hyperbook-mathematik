    {
      "id": "hilfe-t4",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 560
      },
      "data": {
        "title": "Tipp",
        "markdown": "Multipliziere $-2$ mit jedem Glied, Vorzeichen eingeschlossen: $(-2) \\cdot 3x$ und $(-2) \\cdot (-5y)$."
      }
    },
    {
      "id": "t5",
      "type": "task-math",
      "data": {
        "instruction": "Löse die Minusklammer auf.",
        "latex": "-(2x-5)=\\placeholder[a]{}x+\\placeholder[b]{}",
        "blanks": {
          "a": {
            "expected": "-2",
            "accepted": []
          },
          "b": {
            "expected": "5",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "b",
            "latex": "-5",
            "feedback": {
              "message": "Jedes Vorzeichen in der Klammer dreht sich um, auch das vor der 5.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 700
      }
    },
    {
      "id": "hilfe-t5",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 700
      },
      "data": {
        "title": "Tipp",
        "markdown": "Minus vor der Klammer heißt mal $(-1)$. Aus $+2x$ wird $-2x$, aus $-5$ wird $+5$."
      }
    },
    {
      "id": "t6",
      "type": "task-math",
      "data": {
        "instruction": "Vereinfache.",
        "latex": "5x-(2x-4)=\\placeholder[a]{}x+\\placeholder[b]{}",
        "blanks": {
          "a": {
            "expected": "3",
            "accepted": []
          },
          "b": {
            "expected": "4",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "b",
            "latex": "-4",
            "feedback": {
              "message": "Die −4 in der Klammer wird zu +4.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,

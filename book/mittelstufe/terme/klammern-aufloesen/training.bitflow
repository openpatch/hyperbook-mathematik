      }
    },
    {
      "id": "hilfe-t9",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 1260
      },
      "data": {
        "title": "Tipp",
        "markdown": "Jedes Glied durch $-4$ dividieren: $12x : (-4) = -3x$ und $(-8y) : (-4) = 2y$."
      }
    },
    {
      "id": "t10",
      "type": "task-numeric",
      "data": {
        "instruction": "Setze eine Zahl in die Lücke: $-(4x - \\square) = -4x + 9$",
        "expected": "9",
        "tolerance": "exact",
        "decimalSeparator": "both",
        "allowExpression": false,
        "valueFeedback": [
          {
            "value": "-9",
            "feedback": {
              "message": "Das Minus vor der Klammer dreht das Vorzeichen um. Aus −□ wird +□.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false

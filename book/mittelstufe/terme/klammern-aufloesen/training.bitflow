      "id": "hilfe-t10",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 1400
      },
      "data": {
        "title": "Tipp",
        "markdown": "Aus $-\\square$ in der Klammer wird nach dem Auflösen $+\\square$. Es soll $+9$ herauskommen."
      }
    },

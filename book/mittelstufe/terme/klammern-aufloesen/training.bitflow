  "nodes": [
    {
      "id": "start",
      "type": "start-simple",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "title": "Training: Klammern auflösen",
        "markdown": "Zehn Aufgaben zum Distributivgesetz und zu Minusklammern. Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch.",
        "showOutline": false
      }
    },
    {
      "id": "t1",
      "type": "task-math",
      "data": {
        "instruction": "Löse die Klammer auf.",
        "latex": "6(2x-3y)=\\placeholder[a]{}x-\\placeholder[b]{}y",
        "blanks": {
          "a": {
            "expected": "12",
            "accepted": []
          },
          "b": {
            "expected": "18",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "b",
            "latex": "3",
            "feedback": {
              "message": "Die 6 wird mit jedem Glied multipliziert, auch mit 3y.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 140
      }
    },
    {
      "id": "hilfe-t1",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 140
      },
      "data": {
        "title": "Tipp",
        "markdown": "Zwei Bögen: $6 \\cdot 2x$ und $6 \\cdot 3y$."
      }
    },
    {
      "id": "t2",
      "type": "task-math",
      "data": {
        "instruction": "Löse die Klammer auf.",
        "latex": "-4(r-2)=\\placeholder[a]{}r+\\placeholder[b]{}",
        "blanks": {
          "a": {
            "expected": "-4",
            "accepted": []
          },
          "b": {
            "expected": "8",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "b",
            "latex": "-8",
            "feedback": {
              "message": "(−4) · (−2) = +8. Minus mal Minus ergibt Plus.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 280
      }
    },
    {
      "id": "hilfe-t2",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 280
      },
      "data": {
        "title": "Tipp",
        "markdown": "$(-4) \\cdot r = -4r$ und $(-4) \\cdot (-2) = +8$."
      }
    },
    {
      "id": "t3",
      "type": "task-math",
      "data": {
        "instruction": "Löse die Klammer auf.",
        "latex": "2x(3x+5)=\\placeholder[a]{}x^2+\\placeholder[b]{}x",
        "blanks": {
          "a": {
            "expected": "6",
            "accepted": []
          },
          "b": {
            "expected": "10",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "b",
            "latex": "5",
            "feedback": {
              "message": "Auch die 5 wird mit 2x multipliziert: 2x · 5 = 10x.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 420
      }
    },
    {
      "id": "hilfe-t3",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 420
      },
      "data": {
        "title": "Tipp",
        "markdown": "$2x \\cdot 3x = 6x^2$ und $2x \\cdot 5 = 10x$."
      }
    },
    {
      "id": "t4",
      "type": "task-choice",
      "data": {
        "instruction": "$-2(3x - 5y) = $",
        "variant": "single",
        "choices": [
          {
            "id": "o1",
            "markdown": "$-6x + 10y$",
            "correct": true
          },
          {
            "id": "o2",
            "markdown": "$-6x - 10y$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "(−2) · (−5y) = +10y.",
              "severity": "warning"
            }
          },
          {
            "id": "o3",
            "markdown": "$-6x - 5y$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Die −2 wird mit jedem Glied multipliziert.",
              "severity": "warning"
            }
          },
          {
            "id": "o4",
            "markdown": "$6x - 10y$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "(−2) · 3x = −6x.",
              "severity": "warning"
            }
          }
        ],
        "shuffle": true,
        "partialCredit": false,
        "patternFeedback": [],
        "evaluation": {
          "mode": "auto",

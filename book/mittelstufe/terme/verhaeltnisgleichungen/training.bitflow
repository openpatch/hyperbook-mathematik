      "id": "start",
      "type": "start-simple",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "title": "Training: Verhältnisgleichungen",
        "markdown": "Zehn Aufgaben zu Verhältnisgleichungen. Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch.",
        "showOutline": false
      }
    },
    {
      "id": "t1",
      "type": "task-numeric",
      "data": {
        "instruction": "Löse: $x : 6 = 2 : 3$",
        "expected": "4",
        "tolerance": "exact",
        "decimalSeparator": "both",
        "allowExpression": false,
        "valueFeedback": [
          {
            "value": "9",
            "feedback": {
              "message": "Du hast 6 · 3 : 2 gerechnet. Richtig ist x = 2/3 · 6.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 140
      }
    },
    {
      "id": "hilfe-t1",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 140
      },
      "data": {
        "title": "Tipp",
        "markdown": "$\\frac{x}{6} = \\frac{2}{3}$. Multipliziere mit $6$: $x = \\frac{2}{3} \\cdot 6$."
      }
    },
    {

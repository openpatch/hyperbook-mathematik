    {
      "id": "t5",
      "type": "task-choice",
      "data": {
        "instruction": "Welche Gleichung passt? Ein Foto im Format $16 : 9$ hat eine kurze Seite von $18$ cm. Gesucht ist die lange Seite $x$.",
        "variant": "single",
        "choices": [
          {
            "id": "o1",
            "markdown": "$x : 18 = 16 : 9$",
            "correct": true
          },
          {
            "id": "o2",
            "markdown": "$x : 18 = 9 : 16$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Die lange Seite gehört zur 16.",
              "severity": "warning"
            }
          },
          {
            "id": "o3",
            "markdown": "$18 : x = 16 : 9$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Links steht dann kurz : lang, rechts lang : kurz.",
              "severity": "warning"
            }
          },
          {
            "id": "o4",
            "markdown": "$x : 16 = 18 : 9$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Diese Gleichung vergleicht verschiedene Größen.",
              "severity": "warning"
            }
          }
        ],
        "shuffle": true,
        "partialCredit": false,
        "patternFeedback": [],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false

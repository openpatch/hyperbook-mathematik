  "nodes": [
    {
      "id": "start",
      "type": "start-simple",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "title": "Training: Ausklammern",
        "markdown": "Zehn Aufgaben zum Ausklammern. Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch.",
        "showOutline": false
      }
    },
    {
      "id": "t1",
      "type": "task-math",
      "data": {
        "instruction": "Klammere die größte gemeinsame Zahl aus.",
        "latex": "12x+18=\\placeholder[a]{}(\\placeholder[b]{}x+\\placeholder[c]{})",
        "blanks": {
          "a": {
            "expected": "6",
            "accepted": []
          },
          "b": {
            "expected": "2",
            "accepted": []
          },
          "c": {
            "expected": "3",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "a",
            "latex": "3",
            "feedback": {
              "message": "3 ist ein gemeinsamer Teiler, aber nicht der größte.",
              "severity": "warning"
            }
          },
          {
            "blank": "a",
            "latex": "2",
            "feedback": {
              "message": "2 ist ein gemeinsamer Teiler, aber nicht der größte.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 140
      }
    },
    {
      "id": "hilfe-t1",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 140
      },
      "data": {
        "title": "Tipp",
        "markdown": "Der größte gemeinsame Teiler von $12$ und $18$ ist $6$. Dann bleibt $12x : 6 = 2x$ und $18 : 6 = 3$."
      }
    },
    {
      "id": "t2",
      "type": "task-math",
      "data": {
        "instruction": "Klammere so viel wie möglich aus.",
        "latex": "5ab-10a=\\placeholder[a]{}a(b-\\placeholder[b]{})",
        "blanks": {
          "a": {
            "expected": "5",
            "accepted": []
          },
          "b": {
            "expected": "2",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 280
      }
    },
    {
      "id": "hilfe-t2",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 280
      },
      "data": {
        "title": "Tipp",
        "markdown": "Gemeinsam sind $5$ und $a$. Es bleibt $5ab : 5a = b$ und $10a : 5a = 2$."
      }
    },
    {
      "id": "t3",
      "type": "task-math",
      "data": {
        "instruction": "Ergänze.",
        "latex": "14x^2-7x=7x(\\placeholder[a]{}x-\\placeholder[b]{})",
        "blanks": {
          "a": {
            "expected": "2",
            "accepted": []
          },
          "b": {
            "expected": "1",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "b",
            "latex": "0",
            "feedback": {
              "message": "Wird ein ganzes Glied ausgeklammert, bleibt eine 1 stehen: 7x = 7x · 1.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 420
      }
    },
    {
      "id": "hilfe-t3",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 420
      },
      "data": {
        "title": "Tipp",
        "markdown": "$14x^2 = 7x \\cdot 2x$ und $7x = 7x \\cdot 1$."
      }
    },
    {
      "id": "t4",
      "type": "task-choice",
      "data": {
        "instruction": "Welche Umformung ist richtig **und** fertig?",
        "variant": "single",
        "choices": [
          {
            "id": "o1",
            "markdown": "$6ab + 3a = 3a(2b + 1)$",
            "correct": true
          },
          {
            "id": "o2",
            "markdown": "$6ab + 3a = 3a \\cdot 2b$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Probe: 3a · 2b = 6ab. Das Glied 3a fehlt.",
              "severity": "warning"
            }
          },
          {
            "id": "o3",
            "markdown": "$6ab + 3a = a(6b + 3)$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Richtig, aber in der Klammer steckt noch der Faktor 3.",
              "severity": "warning"
            }
          },
          {
            "id": "o4",
            "markdown": "$6ab + 3a = 3(2ab + 1)$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Probe: 3 · 1 = 3, nicht 3a.",
              "severity": "warning"
            }
          }
        ],
        "shuffle": true,
        "partialCredit": false,
        "patternFeedback": [],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 560
      }
    },
    {
      "id": "hilfe-t4",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 560
      },
      "data": {
        "title": "Tipp",
        "markdown": "Mache bei jeder Antwort die Probe durch Ausmultiplizieren. Fertig ist man, wenn in der Klammer kein gemeinsamer Faktor mehr steckt."
      }
    },
    {
      "id": "t5",
      "type": "task-math",
      "data": {
        "instruction": "Klammere so viel wie möglich aus.",

    {
      "id": "hilfe-t5",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 700
      },
      "data": {
        "title": "Tipp",
        "markdown": "Zahlen: größter gemeinsamer Teiler von $24$ und $18$ ist $6$. Variablen: $x$ und $z$ kommen in beiden Gliedern mindestens einmal vor."
      }
    },
    {
      "id": "t6",
      "type": "task-math",
      "data": {
        "instruction": "Klammere $-6c$ aus.",
        "latex": "-30cd-24ce=-6c(\\placeholder[a]{}d+\\placeholder[b]{}e)",
        "blanks": {
          "a": {
            "expected": "5",
            "accepted": []
          },
          "b": {
            "expected": "4",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "b",
            "latex": "-4",
            "feedback": {
              "message": "Probe: −6c · (−4e) = +24ce. Es soll aber −24ce herauskommen.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",

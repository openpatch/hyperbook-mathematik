      },
      "data": {
        "title": "Tipp",
        "markdown": "Kleinste Potenz von $a$ ist $a^3$, von $b$ ist es $b$. Der größte gemeinsame Teiler von $10$ und $8$ ist $2$."
      }
    },
    {
      "id": "t9",
      "type": "task-math",
      "data": {
        "instruction": "Mach es wie Nazar.",

    {
      "id": "hilfe-t6",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 840
      },
      "data": {
        "title": "Tipp",
        "markdown": "$-30cd : (-6c) = 5d$ und $-24ce : (-6c) = 4e$."
      }
    },
    {
      "id": "t7",
      "type": "task-yes-no",
      "data": {
        "question": "Ist die Umformung **fertig**? $12ab + 18ab^2 = 3ab(4 + 6b)$",
        "correctAnswer": false,
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,

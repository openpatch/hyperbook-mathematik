      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 1260
      },
      "data": {
        "title": "Tipp",
        "markdown": "$ax + ay = a(x + y)$ und $bx + by = b(x + y)$. Dann die gemeinsame Klammer $(x + y)$ ausklammern."
      }
    },

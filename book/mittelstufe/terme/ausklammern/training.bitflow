    {
      "id": "hilfe-t7",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 980
      },
      "data": {
        "title": "Tipp",
        "markdown": "In der Klammer haben $4$ und $6b$ noch den gemeinsamen Faktor $2$. Fertig ist $6ab(2 + 3b)$."
      }
    },

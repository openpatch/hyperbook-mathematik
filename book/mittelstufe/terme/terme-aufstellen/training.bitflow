      }
    },
    {
      "id": "hilfe-t10",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 1400
      },
      "data": {
        "title": "Tipp",
        "markdown": "Setze eine Zahl ein, zum Beispiel $x = 10$: $10 - 5 = 5$, aber $5 - 10 = -5$. Ein Gegenbeispiel genügt."
      }
    },

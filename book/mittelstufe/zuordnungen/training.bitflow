    {
      "id": "start",
      "type": "start-simple",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "title": "Trainingslager Zuordnungen",
        "markdown": "Zehn Aufgaben: erst proportional, dann antiproportional, dann gemischt. Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch. Ein Taschenrechner ist erlaubt.",
        "showOutline": false
      }
    },
    {
      "id": "t1",
      "type": "task-choice",
      "position": {
        "x": 0,
        "y": 140
      },
      "data": {
        "instruction": "Welche Tabelle gehört zu einer **proportionalen** Zuordnung?",
        "variant": "single",
        "shuffle": true,
        "choices": [
          {
            "id": "c1",
            "markdown": "| x | 2 | 4 | 6 |\n|---|---|---|---|\n| y | 3 | 6 | 9 |",
            "correct": true
          },
          {
            "id": "c2",
            "markdown": "| x | 2 | 4 | 6 |\n|---|---|---|---|\n| y | 3 | 5 | 7 |",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Prüfe die Quotienten: 3 : 2 = 1,5, aber 5 : 4 = 1,25.",
              "severity": "warning"
            }
          },
          {
            "id": "c3",
            "markdown": "| x | 2 | 4 | 6 |\n|---|---|---|---|\n| y | 12 | 6 | 4 |",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Hier gehört zum Doppelten die Hälfte – das ist antiproportional.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      }
    },

    {
      "id": "t3",
      "type": "task-numeric",
      "position": {
        "x": 0,
        "y": 420
      },
      "data": {
        "instruction": "7 Hefte kosten 11,90 €. Wie viel kosten 3 Hefte?",
        "expected": "5.1",
        "tolerance": "absolute",
        "toleranceValue": 0.01,
        "decimalSeparator": "both",
        "allowExpression": true,
        "valueFeedback": [
          {
            "value": "1.7",
            "feedback": {
              "message": "Das ist der Preis für **ein** Heft. Multipliziere noch mit 3.",
              "severity": "warning"
            }
          },
          {
            "value": "27.77",
            "feedback": {
              "message": "Weniger Hefte kosten weniger. Teile erst durch 7, dann mal 3.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        },
        "unitMode": "shown",
        "unit": "€"
      }
    },

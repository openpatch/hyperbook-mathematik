    {
      "id": "t5",
      "type": "task-choice",
      "position": {
        "x": 0,
        "y": 700
      },
      "data": {
        "instruction": "Welche Zuordnung ist **antiproportional**?",
        "variant": "single",
        "shuffle": true,
        "choices": [
          {
            "id": "c1",
            "markdown": "Anzahl gleich starker Pumpen → Zeit, bis der Pool leer ist",
            "correct": true
          },
          {
            "id": "c2",
            "markdown": "Anzahl Brötchen → Preis",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Doppelt so viele Brötchen kosten doppelt so viel – proportional.",
              "severity": "warning"
            }
          },
          {
            "id": "c3",
            "markdown": "Brenndauer einer Kerze → Länge der Kerze",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Je mehr – desto weniger, aber nach doppelter Zeit ist die Kerze nicht halb so lang.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      }
    },

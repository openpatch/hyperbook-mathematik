      "data": {
        "instruction": "Welche Aussage über den Graphen einer **proportionalen** Zuordnung stimmt?",
        "variant": "single",
        "shuffle": true,
        "choices": [
          {
            "id": "c1",
            "markdown": "Er ist eine Halbgerade, die im Ursprung beginnt.",
            "correct": true
          },
          {
            "id": "c2",
            "markdown": "Er ist eine Gerade, die die $y$-Achse oberhalb des Ursprungs schneidet.",
            "correct": false
          },
          {
            "id": "c3",
            "markdown": "Er ist eine Kurve, die fällt und sich den Achsen nähert.",
            "correct": false
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": false,
          "allowSkip": false

  "nodes": [
    {
      "id": "start",
      "type": "start-simple",
      "position": {
        "x": 0,
        "y": 0
      },
      "data": {
        "title": "Fahrenheit in Celsius umrechnen",
        "markdown": "Sechs Aufgaben zur Umrechnung von Fahrenheit (°F) in Celsius (°C). Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch.",
        "showOutline": false
      }
    },
    {
      "id": "tp-term",
      "type": "task-choice",
      "data": {
        "instruction": "Welcher Term rechnet eine Temperatur F in °F in Grad Celsius um?",
        "variant": "single",
        "choices": [
          {
            "id": "o1",
            "markdown": "$(F - 32) \\cdot  5 : 9$",
            "correct": true
          },
          {
            "id": "o2",
            "markdown": "$F - 32 \\cdot  5 : 9$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Ohne Klammer gilt Punkt vor Strich – dann würde nur 32 mal 5 : 9 gerechnet.",
              "severity": "warning"
            }
          },
          {
            "id": "o3",
            "markdown": "$(F + 32) \\cdot  5 : 9$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Es wird 32 subtrahiert, nicht addiert.",
              "severity": "warning"
            }
          },
          {
            "id": "o4",
            "markdown": "$F \\cdot  5 : 9 - 32$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Zuerst wird 32 subtrahiert, danach mit 5 multipliziert und durch 9 geteilt.",
              "severity": "warning"
            }
          }
        ],
        "shuffle": true,
        "partialCredit": false,
        "patternFeedback": [],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 140
      }
    },
    {
      "id": "hilfe-tp-term",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 210
      },
      "data": {
        "title": "Von Fahrenheit nach Celsius",
        "markdown": "Term: (F − 32) · 5 : 9\n\nBeispiel 212 °F: (212 − 32) · 5 : 9 = 180 · 5 : 9 = 900 : 9 = 100 °C\n\nAchte auf die Klammer: Erst wird 32 abgezogen, dann multipliziert."
      }
    },

    {
      "id": "hilfe-s1-rechenart",
      "type": "title-simple",
      "data": {
        "title": "Rechenart beachten",
        "markdown": "Die Vorzeichenregel gilt nur für **mal** und **geteilt**.\n\nBeim Addieren und Subtrahieren denkst du an die Zahlengerade: (−12) + 3 = −9."
      },
      "position": {
        "x": 360,
        "y": 420
      },
      "section": "stufe1"
    },

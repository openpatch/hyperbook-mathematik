      "data": {
        "title": "Teste dich: Viele Faktoren und Potenzen",
        "markdown": "Zuerst kommen **Grundlagen**. Je nachdem, wie es läuft, geht es danach mit **Profi-Aufgaben** oder einer **Extra-Übung** weiter. Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch.",
        "showOutline": false
      },
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "f-negativ",
      "type": "task-choice",
      "data": {
        "instruction": "Welche Ergebnisse sind negativ? Wähle alle aus.",
        "variant": "multiple",
        "choices": [
          {
            "id": "o1",
            "markdown": "$(-3) \\cdot  4$",
            "correct": true
          },
          {
            "id": "o2",
            "markdown": "$(-2) \\cdot  (-5)$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Zwei Minuszeichen ergeben plus.",
              "severity": "warning"
            }
          },
          {
            "id": "o3",
            "markdown": "$(-1) \\cdot  (-1) \\cdot  (-1)$",
            "correct": true
          },
          {
            "id": "o4",
            "markdown": "$(-2) \\cdot  (-2) \\cdot  (-2) \\cdot  (-2)$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Vier Minuszeichen – eine gerade Anzahl – ergeben plus.",
              "severity": "warning"
            }
          },
          {
            "id": "o5",
            "markdown": "$(-8) \\cdot  0$",
            "correct": false,
            "feedbackWhenChecked": {
              "message": "Mal 0 ergibt 0 – und 0 ist weder positiv noch negativ.",
              "severity": "warning"
            }
          }
        ],

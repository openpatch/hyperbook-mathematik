    {
      "id": "hilfe-m-zuordnen",
      "type": "title-simple",
      "position": {
        "x": 360,
        "y": 210
      },
      "data": {
        "title": "Vorzeichenregel",
        "markdown": "1. Multipliziere die Beträge (ohne Vorzeichen).\n2. Gleiche Vorzeichen → **plus**, verschiedene Vorzeichen → **minus**.\n\nBeispiel: (−2,5) · 4 = −(2,5 · 4) = −10"
      }
    },
    {
      "id": "m1",
      "type": "task-math",
      "data": {
        "instruction": "Berechne.",
        "latex": "(-6) \\cdot  (-8)=\\placeholder[t]{}",
        "blanks": {
          "t": {
            "expected": "48",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "t",
            "latex": "-48",
            "feedback": {
              "message": "Minus mal minus ergibt plus.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 280
      }
    },
    {

      "data": {
        "title": "Rationale Zahlen multiplizieren",
        "markdown": "Acht Aufgaben zum Multiplizieren mit ganzen Zahlen, Dezimalzahlen und Brüchen. Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch.",
        "showOutline": false
      }
    },
    {
      "id": "m-zuordnen",
      "type": "task-matching",
      "data": {
        "instruction": "Ordne jedem Produkt das Ergebnis zu.",

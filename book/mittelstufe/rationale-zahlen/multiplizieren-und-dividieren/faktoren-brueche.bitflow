      "data": {
        "instruction": "Berechne möglichst vorteilhaft.",
        "latex": "\\left(-\\frac{2}{9}\\right)\\cdot \\left(-\\frac{3}{8}\\right)\\cdot \\frac{3}{2}=\\placeholder[t]{}",
        "blanks": {

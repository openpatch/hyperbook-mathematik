    {
      "id": "start",
      "type": "start-simple",
      "data": {
        "title": "Teste dich: Terme berechnen",
        "markdown": "Achte auf die Reihenfolge: Klammer – Potenz – Punkt – Strich. Zuerst kommen **Grundlagen**, danach **Profi-Aufgaben** oder eine **Extra-Übung**. Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch.",
        "showOutline": false
      },
      "position": {
        "x": 0,
        "y": 0
      }
    },
    {
      "id": "t-reihenfolge",
      "type": "task-ordering",
      "data": {
        "instruction": "Bringe die Rechenschritte für $14 - 4 \\cdot  (-2)^{3}$ in die richtige Reihenfolge.",
        "items": [
          {
            "id": "s1",
            "kind": "text",
            "label": "(−2)³ = −8"
          },
          {
            "id": "s2",
            "kind": "text",
            "label": "4 · (−8) = −32"
          },
          {
            "id": "s3",
            "kind": "text",
            "label": "14 − (−32) = 14 + 32"
          },
          {
            "id": "s4",
            "kind": "text",
            "label": "= 46"
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 140
      },
      "section": "basis"
    },
    {

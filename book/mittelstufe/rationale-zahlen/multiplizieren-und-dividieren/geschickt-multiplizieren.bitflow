      "data": {
        "title": "Geschickt multiplizieren",
        "markdown": "Fünf Aufgaben mit Brüchen und Dezimalzahlen. Gib das Ergebnis als Dezimalzahl ein. Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch.",
        "showOutline": false
      }
    },
    {
      "id": "gm1",
      "type": "task-math",
      "data": {
        "instruction": "Berechne.",
        "latex": "\\left(-3{,}5\\right) \\cdot  \\frac{3}{5}=\\placeholder[t]{}",
        "blanks": {
          "t": {
            "expected": "-2.1",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "t",

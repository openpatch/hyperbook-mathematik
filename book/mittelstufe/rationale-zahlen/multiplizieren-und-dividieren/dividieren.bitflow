              "message": "Verschiedene Vorzeichen – der Quotient ist negativ.",
              "severity": "warning"
            }
          },
          {
            "blank": "t",
            "latex": "-4.5",
            "feedback": {
              "message": "Geteilt, nicht mal.",
              "severity": "warning"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false
        }
      },
      "position": {
        "x": 0,
        "y": 280
      },
      "section": "basis"

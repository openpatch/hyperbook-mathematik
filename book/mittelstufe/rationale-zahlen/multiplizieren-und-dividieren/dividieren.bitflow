      },
      "data": {
        "title": "Rationale Zahlen dividieren",
        "markdown": "Acht Aufgaben zum Dividieren. Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch.",
        "showOutline": false
      }
    },
    {
      "id": "d-zuordnen",
      "type": "task-matching",
      "data": {
        "instruction": "Ordne jedem Quotienten das Ergebnis zu.",
        "pairs": [
          {
            "id": "p1",
            "left": {
              "kind": "text",
              "label": "(−45) : (−9)"
            },
            "right": {
              "kind": "text",
              "label": "5"
            }
          },
          {
            "id": "p2",
            "left": {
              "kind": "text",
              "label": "77 : (−7)"
            },
            "right": {
              "kind": "text",
              "label": "−11"
            }
          },
          {
            "id": "p3",
            "left": {
              "kind": "text",
              "label": "(−96) : 3"
            },
            "right": {
              "kind": "text",
              "label": "−32"
            }
          },
          {
            "id": "p4",
            "left": {
              "kind": "text",
              "label": "(−54) : (−6)"
            },
            "right": {
              "kind": "text",
              "label": "9"
            }
          },
          {
            "id": "p5",
            "left": {
              "kind": "text",
              "label": "0 : (−5)"
            },
            "right": {
              "kind": "text",
              "label": "0"
            }
          }
        ],
        "evaluation": {
          "mode": "auto",
          "enableRetry": false,
          "showFeedback": true,
          "allowSkip": false

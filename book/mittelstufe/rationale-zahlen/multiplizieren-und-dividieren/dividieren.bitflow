    {
      "id": "hilfe-d2",
      "type": "title-simple",
      "data": {
        "title": "Durch eine Dezimalzahl teilen",
        "markdown": "Verschiebe bei beiden Zahlen das Komma um gleich viele Stellen, bis der Divisor eine ganze Zahl ist.\n\n6 : 0,3 = 60 : 3 = 20 → mit Vorzeichen: 6 : (−0,3) = −20"
      },
      "position": {
        "x": 360,
        "y": 420
      },
      "section": "basis"

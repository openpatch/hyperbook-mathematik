      },
      "data": {
        "title": "Brüche und Dezimalzahlen dividieren",
        "markdown": "Fünf Aufgaben. Gib das Ergebnis als Dezimalzahl oder – wenn das nicht geht – als Bruch ein. Bei einem Fehler bekommst du einen Hinweis und einen zweiten Versuch.",
        "showOutline": false
      }
    },
    {
      "id": "dg1",
      "type": "task-math",
      "data": {
        "instruction": "Berechne.",
        "latex": "\\left(-0{,}6\\right) : \\frac{1}{2}=\\placeholder[t]{}",
        "blanks": {
          "t": {
            "expected": "-1.2",
            "accepted": []
          }
        },
        "compare": "symbolic",
        "partialCredit": false,
        "virtualKeyboard": true,
        "blankFeedback": [
          {
            "blank": "t",
            "latex": "-0.3",
            "feedback": {
              "message": "Durch 1/2 teilen heißt mal 2 nehmen.",
              "severity": "warning"
            }
          },
          {
            "blank": "t",
            "latex": "1.2",
            "feedback": {
              "message": "Verschiedene Vorzeichen – der Quotient ist negativ.",
              "severity": "warning"
